{
  "$schema": "https://forge.ui8.ai/schemas/stories.v3.json",
  "name": "Anhang A8 Only Is Better Than Best",
  "component": "./S04Only.tsx",
  "canvas": {
    "layout": "flow"
  },
  "sections": [
    {
      "title": null,
      "controls": [
        {
          "prop": "illustration",
          "control": "switch",
          "label": "Illustration",
          "default": true
        },
        {
          "prop": "figur",
          "control": "segmented",
          "label": "Bild",
          "options": [
            "anatomie",
            "linie"
          ],
          "default": "anatomie",
          "visibleWhen": {
            "prop": "illustration",
            "equals": true
          }
        },
        {
          "prop": "side",
          "control": "segmented",
          "label": "Illustration",
          "options": [
            "left",
            "right"
          ],
          "default": "right",
          "visibleWhen": {
            "prop": "illustration",
            "equals": true
          }
        },
        {
          "prop": "chrome",
          "control": "switch",
          "label": "Kopf- und Fusszeile",
          "default": true
        }
      ]
    }
  ],
  "values": {}
}
